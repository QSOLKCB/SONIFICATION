MAT010_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"∀ {claims : List MAT010.Archive.Claim} {snapshots : List MAT010.Archive.Snapshot} {out : List MAT010.Archive.Artifact},\n  MAT010.Archive.validate claims snapshots = some out →\n    List.map MAT010.Archive.Claim.profile claims = MAT010.Archive.stages ∧\n      List.map MAT010.Archive.Snapshot.identifier snapshots = MAT010.Archive.stages ∧\n        claims.length = 9 ∧ snapshots.length = 9","origin":"ArchiveModel","kind":"theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT010.Archive.M010_A1_ordered_nine","axioms":["propext","Quot.sound"]}
MAT010_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"∀ {claims : List MAT010.Archive.Claim} {snapshots : List MAT010.Archive.Snapshot} {out : List MAT010.Archive.Artifact},\n  MAT010.Archive.validate claims snapshots = some out →\n    (List.map MAT010.Archive.Claim.mergedCommit claims).Nodup ∧\n      ∀ (claim : MAT010.Archive.Claim), claim ∈ claims → MAT010.Archive.validCommit claim.mergedCommit = true","origin":"ArchiveModel","kind":"theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT010.Archive.M010_A2_commit_identities","axioms":["propext","Quot.sound"]}
MAT010_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"∀ {claims : List MAT010.Archive.Claim} {snapshots : List MAT010.Archive.Snapshot} {out : List MAT010.Archive.Artifact},\n  MAT010.Archive.validate claims snapshots = some out →\n    ∀ (artifact : MAT010.Archive.Artifact),\n      artifact ∈ out →\n        artifact.stage ∈ MAT010.Archive.stages ∧\n          MAT010.Archive.validName artifact.name = true ∧\n            MAT010.Archive.validDigest artifact.sha256 = true ∧\n              (MAT010.Archive.hasMidiSuffix artifact.name = true → artifact.stage = MAT010.Archive.firstStage) ∧\n                ∃ claim snapshot member,\n                  (claim, snapshot) ∈ claims.zip snapshots ∧\n                    member ∈ snapshot.members ∧\n                      claim.version = artifact.version ∧ artifact = MAT010.Archive.artifactOf snapshot member","origin":"ArchiveModel","kind":"theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT010.Archive.M010_A3_valid_artifact_identity","axioms":["propext","Quot.sound"]}
