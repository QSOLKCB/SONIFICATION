SONIFICATION_DECL {"unsafe_definition":false,"type":"(Sonification.Mat008.scan\n        [{ campaign := \"A\", originalRun := \"RUN\" }, { campaign := \"B\", originalRun := \"RUN\" },\n          { campaign := \"B\", originalRun := \"OTHER\" }]).conflict =\n    true ∧\n  (Sonification.Mat008.scan\n        [{ campaign := \"A\", originalRun := \"RUN_A\" }, { campaign := \"B\", originalRun := \"RUN_B\" }]).conflict =\n    false","origin":"Audit","kind":"non_theorem","declaration":"Mat008StatementChecks.check_nonvacuity","axioms":[]}
SONIFICATION_DECL {"unsafe_definition":false,"type":"∀ (rows : List Sonification.Mat008.ParsedRow) (a b : Sonification.Mat008.ParsedRow),\n  a ∈ rows →\n    b ∈ rows → a.originalRun = b.originalRun → a.campaign ≠ b.campaign → (Sonification.Mat008.scan rows).conflict = true","origin":"Audit","kind":"non_theorem","declaration":"Mat008StatementChecks.check_reused_run_blocks","axioms":["propext","Classical.choice","Quot.sound"]}
SONIFICATION_DECL {"unsafe_definition":false,"type":"∀ (s : Sonification.Mat008.State) (xs ys : List Sonification.Mat008.ParsedRow),\n  Sonification.Mat008.scanFrom s (xs ++ ys) = Sonification.Mat008.scanFrom (Sonification.Mat008.scanFrom s xs) ys","origin":"Audit","kind":"non_theorem","declaration":"Mat008StatementChecks.check_scanFrom_append","axioms":[]}
SONIFICATION_DECL {"unsafe_definition":false,"type":"∀ (rows : List Sonification.Mat008.ParsedRow) (row : Sonification.Mat008.ParsedRow),\n  Sonification.Mat008.scan (rows ++ [row]) = Sonification.Mat008.step (Sonification.Mat008.scan rows) row","origin":"Audit","kind":"non_theorem","declaration":"Mat008StatementChecks.check_scan_append","axioms":["propext"]}
