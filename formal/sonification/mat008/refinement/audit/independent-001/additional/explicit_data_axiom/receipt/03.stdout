MAT008_REFINE_DECL {"unsafe_definition":false,"type":"∀ (instruction : Sonification.Mat008.AbstractPy.GateInstruction) (frame : Sonification.Mat008.AbstractPy.GateFrame),\n  Sonification.Mat008.AbstractPy.executeInstruction instruction frame =\n    if instruction = Sonification.Mat008.AbstractPy.GateInstruction.testExistingOwner then\n      { state := frame.state, row := frame.row,\n        mismatchFlag := Sonification.Mat008.AbstractPy.mismatch frame.state frame.row }\n    else\n      if instruction = Sonification.Mat008.AbstractPy.GateInstruction.insertReasonIfMismatch then\n        if frame.mismatchFlag = true then\n          {\n            state :=\n              { owners := frame.state.owners,\n                reasons :=\n                  Sonification.Mat008.AbstractPy.insert frame.state.reasons\n                    Sonification.Mat008.AbstractPy.reuseReason },\n            row := frame.row, mismatchFlag := frame.mismatchFlag }\n        else frame\n      else\n        if instruction = Sonification.Mat008.AbstractPy.GateInstruction.overwriteOwner then\n          {\n            state :=\n              {\n                owners :=\n                  Sonification.Mat008.AbstractPy.write frame.state.owners frame.row.originalRun frame.row.campaign,\n                reasons := frame.state.reasons },\n            row := frame.row, mismatchFlag := frame.mismatchFlag }\n        else frame","origin":"Refine.MapReason","kind":"theorem","declaration":"Sonification.Mat008.AbstractPy.executeInstruction.eq_1","axioms":[]}
