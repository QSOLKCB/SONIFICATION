MAT008_REFINE_DECL {"unsafe_definition":false,"type":"∀ (s : Sonification.Mat008.AbstractPy.PyState) (row : Sonification.Mat008.AbstractPy.AcceptedRow),\n  s.reasons Sonification.Mat008.AbstractPy.reuseReason = false →\n    ((Sonification.Mat008.AbstractPy.pyStep s row).reasons Sonification.Mat008.AbstractPy.reuseReason = true ↔\n      Sonification.Mat008.AbstractPy.mismatch s row = true)","origin":"Audit","kind":"non_theorem","declaration":"RefineStatementChecks.check_new_reason_iff_mismatch","axioms":["propext"]}
MAT008_REFINE_DECL {"unsafe_definition":false,"type":"(Sonification.Mat008.AbstractPy.pyScanFrom Sonification.Mat008.AbstractPy.empty\n          [{ campaign := \"A\", originalRun := \"RUN\" }, { campaign := \"B\", originalRun := \"RUN\" },\n            { campaign := \"B\", originalRun := \"OTHER\" }]).reasons\n      Sonification.Mat008.AbstractPy.reuseReason =\n    true ∧\n  (Sonification.Mat008.AbstractPy.pyScanFrom Sonification.Mat008.AbstractPy.empty\n          [{ campaign := \"A\", originalRun := \"RUN_A\" }, { campaign := \"B\", originalRun := \"RUN_B\" }]).reasons\n      Sonification.Mat008.AbstractPy.reuseReason =\n    false","origin":"Audit","kind":"non_theorem","declaration":"RefineStatementChecks.check_nonvacuity","axioms":[]}
MAT008_REFINE_DECL {"unsafe_definition":false,"type":"let s := { owners := fun x => none, reasons := fun x => true };\nSonification.Mat008.AbstractPy.mismatch s { campaign := \"CAMPAIGN\", originalRun := \"RUN\" } = false ∧\n  (Sonification.Mat008.AbstractPy.pyStep s { campaign := \"CAMPAIGN\", originalRun := \"RUN\" }).reasons\n      Sonification.Mat008.AbstractPy.reuseReason =\n    true","origin":"Audit","kind":"non_theorem","declaration":"RefineStatementChecks.check_preexisting_reason_counterexample","axioms":[]}
