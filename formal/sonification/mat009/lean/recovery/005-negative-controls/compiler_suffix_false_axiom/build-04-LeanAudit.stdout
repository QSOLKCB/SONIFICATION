MAT009_DECL {"unsafe_definition":true,"unsafe_axiom":false,"type":"_obj → _obj","origin":"DiagnosticFirstOwner","kind":"compiler_auxiliary","is_axiom":false,"has_source_range":false,"declaration":"MAT009.Diagnostic.empty._cstage2","axioms":[]}
MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"∀ (x : String), MAT009.Diagnostic.empty x = none","origin":"DiagnosticFirstOwner","kind":"theorem","is_axiom":false,"has_source_range":false,"declaration":"MAT009.Diagnostic.empty.eq_1","axioms":[]}
MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"MAT009.Diagnostic.scan MAT009.Diagnostic.empty [(\"D\", \"CAMPAIGN_A\", \"TRAIN\"), (\"D\", \"CAMPAIGN_B\", \"HOLDOUT\")] \"D\" =\n  some (\"CAMPAIGN_A\", \"TRAIN\")","origin":"DiagnosticFirstOwner","kind":"theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT009.Diagnostic.first_owner_not_last_writer","axioms":["propext"]}
MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"MAT009.Diagnostic.Registry → String → MAT009.Diagnostic.Owner → MAT009.Diagnostic.Registry","origin":"DiagnosticFirstOwner","kind":"non_theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT009.Diagnostic.register","axioms":[]}
MAT009_DECL {"unsafe_definition":true,"unsafe_axiom":false,"type":"MAT009.Diagnostic.Registry → String → MAT009.Diagnostic.Owner → MAT009.Diagnostic.Registry","origin":"DiagnosticFirstOwner","kind":"compiler_auxiliary","is_axiom":false,"has_source_range":false,"declaration":"MAT009.Diagnostic.register._cstage1","axioms":[]}
MAT009_DECL {"unsafe_definition":true,"unsafe_axiom":false,"type":"_obj → _obj → _obj → _obj → _obj","origin":"DiagnosticFirstOwner","kind":"compiler_auxiliary","is_axiom":false,"has_source_range":false,"declaration":"MAT009.Diagnostic.register._cstage2","axioms":[]}
MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"∀ (registry : MAT009.Diagnostic.Registry) (identity : String) (candidate : MAT009.Diagnostic.Owner) (key : String),\n  MAT009.Diagnostic.register registry identity candidate key =\n    if key = identity then\n      match registry key with\n      | none => some candidate\n      | some first => some first\n    else registry key","origin":"DiagnosticFirstOwner","kind":"theorem","is_axiom":false,"has_source_range":false,"declaration":"MAT009.Diagnostic.register.eq_1","axioms":[]}
MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"(motive : Option MAT009.Diagnostic.Owner → Sort u_1) →\n  (x : Option MAT009.Diagnostic.Owner) →\n    (Unit → motive none) → ((first : MAT009.Diagnostic.Owner) → motive (some first)) → motive x","origin":"DiagnosticFirstOwner","kind":"non_theorem","is_axiom":false,"has_source_range":false,"declaration":"MAT009.Diagnostic.register.match_1","axioms":[]}
