MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"∀ (parent : MAT009.ReasonSet) (rows : List MAT009.Row) (reason : String),\n  parent reason → (MAT009.finalize (MAT009.scan (MAT009.initial parent) rows)).status = MAT009.Status.blocked","origin":"TypedConsumer","kind":"theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT009.Consumer.parent_reason_blocks_any_scan","axioms":["Classical.choice","propext","Quot.sound"]}
MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"∀ (parent : MAT009.ReasonSet) (rows : List MAT009.Row) (campaign : String),\n  (∃ row, row ∈ rows ∧ row.role = MAT009.Role.train ∧ row.campaign = campaign) →\n    (∃ row, row ∈ rows ∧ row.role = MAT009.Role.holdout ∧ row.campaign = campaign) →\n      (MAT009.finalize (MAT009.scan (MAT009.initial parent) rows)).status = MAT009.Status.blocked","origin":"TypedConsumer","kind":"theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT009.Consumer.shared_campaign_blocks_any_scan","axioms":["Classical.choice","propext","Quot.sound"]}
MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"Type","origin":"DiagnosticFirstOwner","kind":"non_theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT009.Diagnostic.Owner","axioms":[]}
