MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"∀ (parent : MAT009.ReasonSet) (role : MAT009.Role) (campaign lab reason : String),\n  (MAT009.initial parent).owner campaign = none ∧\n    ¬(MAT009.initial parent).campaigns role campaign ∧\n      ¬(MAT009.initial parent).labs role lab ∧\n        ¬(MAT009.initial parent).crossed ∧ ((MAT009.initial parent).parent reason ↔ parent reason)","origin":"SplitModel","kind":"theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT009.M009_R1_initial","axioms":["propext"]}
MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"∀ (s : MAT009.State) (row : MAT009.Row),\n  (MAT009.step s row).owner row.campaign = some row.role ∧\n    (∀ (key : String), key ≠ row.campaign → (MAT009.step s row).owner key = s.owner key) ∧\n      (∀ (role : MAT009.Role) (key : String),\n          (MAT009.step s row).campaigns role key ↔ s.campaigns role key ∨ role = row.role ∧ key = row.campaign) ∧\n        ∀ (role : MAT009.Role) (key : String),\n          (MAT009.step s row).labs role key ↔ s.labs role key ∨ role = row.role ∧ key = row.lab","origin":"SplitModel","kind":"theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT009.M009_R2_assignment_overwrite","axioms":["propext"]}
