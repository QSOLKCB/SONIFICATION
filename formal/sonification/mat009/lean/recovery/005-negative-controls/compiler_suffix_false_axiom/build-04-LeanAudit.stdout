MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"∀ (s : MAT009.State) (row : MAT009.Row) (role : MAT009.Role) (campaign lab reason : String),\n  (s.campaigns role campaign → (MAT009.step s row).campaigns role campaign) ∧\n    (s.labs role lab → (MAT009.step s row).labs role lab) ∧\n      (s.crossed → (MAT009.step s row).crossed) ∧\n        (MAT009.familyLeakage s → MAT009.familyLeakage (MAT009.step s row)) ∧\n          ((MAT009.step s row).parent reason ↔ s.parent reason)","origin":"SplitModel","kind":"theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT009.M009_R4_stickiness","axioms":[]}
MAT009_DECL {"unsafe_definition":false,"unsafe_axiom":false,"type":"∀ (s : MAT009.State),\n  (MAT009.finalize s).childReason MAT009.leakageReason ↔\n    (∃ key, s.campaigns MAT009.Role.train key ∧ s.campaigns MAT009.Role.holdout key) ∨\n      ∃ key, s.labs MAT009.Role.train key ∧ s.labs MAT009.Role.holdout key","origin":"SplitModel","kind":"theorem","is_axiom":false,"has_source_range":true,"declaration":"MAT009.M009_R5_final_set_intersection","axioms":["propext"]}
