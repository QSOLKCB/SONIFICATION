MAT009.M009_R1_initial (parent : ReasonSet) (role : Role) (campaign lab reason : String) :
  (initial parent).owner campaign = none ∧
    ¬(initial parent).campaigns role campaign ∧
      ¬(initial parent).labs role lab ∧ ¬(initial parent).crossed ∧ ((initial parent).parent reason ↔ parent reason)
MAT009.M009_R2_assignment_overwrite (s : State) (row : Row) :
  (step s row).owner row.campaign = some row.role ∧
    (∀ (key : String), key ≠ row.campaign → (step s row).owner key = s.owner key) ∧
      (∀ (role : Role) (key : String),
          (step s row).campaigns role key ↔ s.campaigns role key ∨ role = row.role ∧ key = row.campaign) ∧
        ∀ (role : Role) (key : String), (step s row).labs role key ↔ s.labs role key ∨ role = row.role ∧ key = row.lab
MAT009.M009_R3_cross_role_trigger (s : State) (row : Row) :
  (step s row).crossed ↔ s.crossed ∨ ∃ previous, s.owner row.campaign = some previous ∧ previous ≠ row.role
MAT009.M009_R4_stickiness (s : State) (row : Row) (role : Role) (campaign lab reason : String) :
  (s.campaigns role campaign → (step s row).campaigns role campaign) ∧
    (s.labs role lab → (step s row).labs role lab) ∧
      (s.crossed → (step s row).crossed) ∧
        (familyLeakage s → familyLeakage (step s row)) ∧ ((step s row).parent reason ↔ s.parent reason)
MAT009.M009_R5_final_set_intersection (s : State) :
  (finalize s).childReason leakageReason ↔
    (∃ key, s.campaigns Role.train key ∧ s.campaigns Role.holdout key) ∨
      ∃ key, s.labs Role.train key ∧ s.labs Role.holdout key
MAT009.M009_R5_parent_union (s : State) :
  (finalize s).hasReason leakageReason ↔ s.parent leakageReason ∨ familyLeakage s
MAT009.M009_R6_cross_trigger_in_finite_scan (s : State) (before after : List Row) (row : Row)
  (h : ∃ previous, (scan s before).owner row.campaign = some previous ∧ previous ≠ row.role) :
  (scan s (before ++ row :: after)).crossed
MAT009.M009_R6_arbitrary_finite_scan (parent : ReasonSet) (rows : List Row) (role : Role)
  (campaign lab reason : String) :
  ((scan (initial parent) rows).campaigns role campaign ↔
      ∃ row, row ∈ rows ∧ row.role = role ∧ row.campaign = campaign) ∧
    ((scan (initial parent) rows).labs role lab ↔ ∃ row, row ∈ rows ∧ row.role = role ∧ row.lab = lab) ∧
      ((scan (initial parent) rows).parent reason ↔ parent reason)
MAT009.M009_R6_latest_owner (parent : ReasonSet) (rows : List Row) (campaign : String) :
  (scan (initial parent) rows).owner campaign = lastRole rows campaign
MAT009.M009_R6_parent_reason_survives (parent : ReasonSet) (rows : List Row) (reason : String) :
  parent reason → (finalize (scan (initial parent) rows)).hasReason reason
MAT009.M009_R6_final_leakage_iff (parent : ReasonSet) (rows : List Row) :
  (finalize (scan (initial parent) rows)).childReason leakageReason ↔
    (∃ key,
        (∃ row, row ∈ rows ∧ row.role = Role.train ∧ row.campaign = key) ∧
          ∃ row, row ∈ rows ∧ row.role = Role.holdout ∧ row.campaign = key) ∨
      ∃ key,
        (∃ row, row ∈ rows ∧ row.role = Role.train ∧ row.lab = key) ∧
          ∃ row, row ∈ rows ∧ row.role = Role.holdout ∧ row.lab = key
MAT009.M009_R7_accepted_example :
  (finalize (scan (initial noParent) cleanRows)).status = Status.structuralOnlyUnauthenticated
MAT009.M009_R7_rejected_example : (finalize (scan (initial noParent) crossingRows)).status = Status.blocked
MAT009.M009_R7_nonvacuous :
  (∃ rows, (finalize (scan (initial noParent) rows)).status = Status.structuralOnlyUnauthenticated) ∧
    ∃ rows, (finalize (scan (initial noParent) rows)).status = Status.blocked
MAT009.Diagnostic.scan_first_owner_sticky (registry : Diagnostic.Registry) (updates : List (String × Diagnostic.Owner))
  (key : String) (first : Diagnostic.Owner) (h : registry key = some first) :
  Diagnostic.scan registry updates key = some first
'MAT009.M009_R1_initial' depends on axioms: [propext]
