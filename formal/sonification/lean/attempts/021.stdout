SONIFICATION_DECL {"type":"∀ (a b : Sonification.Interval),\n  Sonification.Ordered.classify Sonification.Ordered.integerOrder { lo := a.lo, hi := a.hi }\n      { lo := b.lo, hi := b.hi } =\n    Option.map\n      (fun r =>\n        match r with\n        | Sonification.Relation.below => Sonification.Ordered.Relation.below\n        | Sonification.Relation.above => Sonification.Ordered.Relation.above\n        | Sonification.Relation.overlap => Sonification.Ordered.Relation.overlap)\n      (Sonification.classify a b)","origin":"Sonification.OrderedIntervals","kind":"theorem","declaration":"Sonification.Ordered.integer_specialization","axioms":["propext","Quot.sound"]}
