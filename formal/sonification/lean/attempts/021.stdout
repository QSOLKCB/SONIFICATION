SONIFICATION_DECL {"type":"∀ (a b : Sonification.Interval), Sonification.classify b a = Option.map Sonification.reverse (Sonification.classify a b)","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.IntegerChecks.Sonification_reversal","axioms":["propext","Quot.sound"]}
SONIFICATION_DECL {"type":"∀ (a b : Sonification.Interval),\n  Sonification.classify a b = some Sonification.Relation.below ↔\n    Sonification.Valid a ∧ Sonification.Valid b ∧ a.hi < b.lo","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.IntegerChecks.Sonification_below_iff","axioms":["propext","Quot.sound","Classical.choice"]}
SONIFICATION_DECL {"type":"∀ {α β : Type} (o : Sonification.Ordered.OrderSpec α) (p : Sonification.Ordered.OrderSpec β) (f : α → β),\n  (∀ (x y : α), p.lt (f x) (f y) ↔ o.lt x y) →\n    ∀ (a b : Sonification.Ordered.Interval α),\n      Sonification.Ordered.classify p (Sonification.Ordered.map f a) (Sonification.Ordered.map f b) =\n        Sonification.Ordered.classify o a b","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.OrderedChecks.Sonification_Ordered_order_reflecting_map","axioms":["propext"]}
SONIFICATION_DECL {"type":"∀ (a b : Sonification.Interval),\n  Sonification.Valid a →\n    Sonification.Valid b → a.hi = b.lo → Sonification.classify a b = some Sonification.Relation.overlap","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.IntegerChecks.Sonification_touching","axioms":["propext","Quot.sound","Classical.choice"]}
SONIFICATION_DECL {"type":"(motive : Sonification.Relation → Sort u_1) →\n  (r : Sonification.Relation) →\n    (Unit → motive Sonification.Relation.below) →\n      (Unit → motive Sonification.Relation.above) → (Unit → motive Sonification.Relation.overlap) → motive r","origin":"Audit","kind":"compiler_auxiliary","declaration":"SonificationStatementChecks.OrderedChecks.Sonification_Ordered_integer_specialization.match_1._cstage1","axioms":[]}
