SONIFICATION_DECL {"type":"∀ {α : Type} (o : Sonification.Ordered.OrderSpec α) (a b : Sonification.Ordered.Interval α),\n  Sonification.Ordered.classify o a b =\n    if o.lt a.hi a.lo ∨ o.lt b.hi b.lo then none\n    else\n      if o.lt a.hi b.lo then some Sonification.Ordered.Relation.below\n      else\n        if o.lt b.hi a.lo then some Sonification.Ordered.Relation.above else some Sonification.Ordered.Relation.overlap","origin":"Sonification.OrderedIntervals","kind":"theorem","declaration":"Sonification.Ordered.classify.eq_1","axioms":[]}
