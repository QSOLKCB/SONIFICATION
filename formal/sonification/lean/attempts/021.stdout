SONIFICATION_DECL {"type":"∀ (a b : Sonification.Interval),\n  Sonification.classify a b = some Sonification.Relation.above ↔\n    Sonification.Valid a ∧ Sonification.Valid b ∧ b.hi < a.lo","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.IntegerChecks.Sonification_above_iff","axioms":["propext","Quot.sound","Classical.choice"]}
SONIFICATION_DECL {"type":"∀ (a b : Sonification.Interval),\n  Sonification.classify a b = some Sonification.Relation.overlap ↔\n    Sonification.Valid a ∧ Sonification.Valid b ∧ a.lo ≤ b.hi ∧ b.lo ≤ a.hi","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.IntegerChecks.Sonification_overlap_iff","axioms":["propext","Quot.sound","Classical.choice"]}
SONIFICATION_DECL {"type":"∀ {α : Type} (o : Sonification.Ordered.OrderSpec α) (a b : Sonification.Ordered.Interval α),\n  Sonification.Ordered.Valid o a →\n    Sonification.Ordered.Valid o b →\n      Sonification.Ordered.classify o a b = some Sonification.Ordered.Relation.below ∨\n        Sonification.Ordered.classify o a b = some Sonification.Ordered.Relation.above ∨\n          Sonification.Ordered.classify o a b = some Sonification.Ordered.Relation.overlap","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.OrderedChecks.Sonification_Ordered_exhaustive","axioms":["propext"]}
SONIFICATION_DECL {"type":"∀ {α : Type} (o : Sonification.Ordered.OrderSpec α) (a b : Sonification.Ordered.Interval α),\n  Sonification.Ordered.Valid o a → Sonification.Ordered.Valid o b → ¬(o.lt a.hi b.lo ∧ o.lt b.hi a.lo)","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.OrderedChecks.Sonification_Ordered_separation_exclusive","axioms":[]}
SONIFICATION_DECL {"type":"∀ (k : Int) (a b : Sonification.Interval),\n  0 < k → Sonification.classify (Sonification.scale k a) (Sonification.scale k b) = Sonification.classify a b","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.IntegerChecks.Sonification_positive_scale","axioms":["propext","Quot.sound"]}
SONIFICATION_DECL {"type":"Sonification.classify { lo := 0, hi := 1 } { lo := 2, hi := 3 } = some Sonification.Relation.below ∧\n  Sonification.classify { lo := 2, hi := 3 } { lo := 0, hi := 1 } = some Sonification.Relation.above ∧\n    Sonification.classify { lo := 0, hi := 1 } { lo := 1, hi := 2 } = some Sonification.Relation.overlap ∧\n      Sonification.classify { lo := 1, hi := 0 } { lo := 0, hi := 0 } = none","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.IntegerChecks.Sonification_inhabited_branches","axioms":[]}
SONIFICATION_DECL {"type":"∀ {α : Type} (o : Sonification.Ordered.OrderSpec α) (a b : Sonification.Ordered.Interval α),\n  Sonification.Ordered.classify o a b = some Sonification.Ordered.Relation.below ↔\n    Sonification.Ordered.Valid o a ∧ Sonification.Ordered.Valid o b ∧ o.lt a.hi b.lo","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.OrderedChecks.Sonification_Ordered_classify_below_iff","axioms":["propext"]}
SONIFICATION_DECL {"type":"∀ (a b : Sonification.Interval),\n  Sonification.Valid a →\n    Sonification.Valid b →\n      Sonification.classify a b = some Sonification.Relation.below ∨\n        Sonification.classify a b = some Sonification.Relation.above ∨\n          Sonification.classify a b = some Sonification.Relation.overlap","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.IntegerChecks.Sonification_exhaustive","axioms":["propext","Quot.sound"]}
SONIFICATION_DECL {"type":"∀ (a b : Sonification.Interval),\n  Sonification.Valid a →\n    Sonification.Valid b →\n      ¬(a.hi < b.lo ∧ b.hi < a.lo) ∧\n        ¬(a.hi < b.lo ∧ a.lo ≤ b.hi ∧ b.lo ≤ a.hi) ∧ ¬(b.hi < a.lo ∧ a.lo ≤ b.hi ∧ b.lo ≤ a.hi)","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.IntegerChecks.Sonification_exclusive","axioms":["Classical.choice","propext","Quot.sound"]}
SONIFICATION_DECL {"type":"∀ (a b : Sonification.Interval),\n  Sonification.Ordered.classify Sonification.Ordered.integerOrder { lo := a.lo, hi := a.hi }\n      { lo := b.lo, hi := b.hi } =\n    Option.map\n      (fun r =>\n        match r with\n        | Sonification.Relation.below => Sonification.Ordered.Relation.below\n        | Sonification.Relation.above => Sonification.Ordered.Relation.above\n        | Sonification.Relation.overlap => Sonification.Ordered.Relation.overlap)\n      (Sonification.classify a b)","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.OrderedChecks.Sonification_Ordered_integer_specialization","axioms":["propext","Quot.sound"]}
SONIFICATION_DECL {"type":"∀ (k x y : Int), 0 < k → (k * x < k * y ↔ x < y)","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.IntegerChecks.Sonification_scale_lt_iff","axioms":["propext","Quot.sound"]}
SONIFICATION_DECL {"type":"∀ {α : Type} (o : Sonification.Ordered.OrderSpec α) (a b : Sonification.Ordered.Interval α),\n  Sonification.Ordered.classify o a b = some Sonification.Ordered.Relation.overlap ↔\n    Sonification.Ordered.Valid o a ∧ Sonification.Ordered.Valid o b ∧ ¬o.lt a.hi b.lo ∧ ¬o.lt b.hi a.lo","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.OrderedChecks.Sonification_Ordered_classify_overlap_iff","axioms":["propext"]}
