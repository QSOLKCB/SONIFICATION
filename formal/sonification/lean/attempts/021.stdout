SONIFICATION_DECL {"type":"{α : Type} →\n  {motive : Sonification.Ordered.OrderSpec α → Sort u} →\n    (t : Sonification.Ordered.OrderSpec α) →\n      ((lt : α → α → Prop) →\n          (decLt : DecidableRel lt) →\n            (irrefl : ∀ (x : α), ¬lt x x) →\n              (trans : ∀ {x y z : α}, lt x y → lt y z → lt x z) →\n                (lt_of_lt_of_not_gt : ∀ {x y z : α}, lt x y → ¬lt z y → lt x z) →\n                  motive\n                    { lt := lt, decLt := decLt, irrefl := irrefl, trans := trans,\n                      lt_of_lt_of_not_gt := lt_of_lt_of_not_gt }) →\n        motive t","origin":"Sonification.OrderedIntervals","kind":"non_theorem","declaration":"Sonification.Ordered.OrderSpec.recOn","axioms":[]}
