SONIFICATION_DECL {"type":"∀ {α : Type} (o : Sonification.Ordered.OrderSpec α) (a b : Sonification.Ordered.Interval α),\n  Sonification.Ordered.classify o a b = some Sonification.Ordered.Relation.overlap ↔\n    Sonification.Ordered.Valid o a ∧ Sonification.Ordered.Valid o b ∧ ¬o.lt a.hi b.lo ∧ ¬o.lt b.hi a.lo","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.OrderedChecks.Sonification_Ordered_classify_overlap_iff","axioms":["propext"]}
SONIFICATION_DECL {"type":"∀ {α : Type} (o : Sonification.Ordered.OrderSpec α) {x y : α}, o.lt x y → ¬o.lt y x","origin":"Audit","kind":"non_theorem","declaration":"SonificationStatementChecks.OrderedChecks.Sonification_Ordered_asymmetric","axioms":[]}
