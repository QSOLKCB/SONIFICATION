[
  {
    "axioms": [
      "propext",
      "Quot.sound"
    ],
    "declaration": "Sonification.Ordered.integer_specialization",
    "kind": "theorem",
    "origin": "Sonification.OrderedIntervals",
    "type": "\u2200 (a b : Sonification.Interval),\n  Sonification.Ordered.classify Sonification.Ordered.integerOrder { lo := a.lo, hi := a.hi }\n      { lo := b.lo, hi := b.hi } =\n    Option.map\n      (fun r =>\n        match r with\n        | Sonification.Relation.below => Sonification.Ordered.Relation.below\n        | Sonification.Relation.above => Sonification.Ordered.Relation.above\n        | Sonification.Relation.overlap => Sonification.Ordered.Relation.overlap)\n      (Sonification.classify a b)",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext",
      "Quot.sound"
    ],
    "declaration": "Sonification.reversal",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "\u2200 (a b : Sonification.Interval), Sonification.classify b a = Option.map Sonification.reverse (Sonification.classify a b)",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext",
      "Quot.sound",
      "Classical.choice"
    ],
    "declaration": "Sonification.above_iff",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "\u2200 (a b : Sonification.Interval),\n  Sonification.classify a b = some Sonification.Relation.above \u2194\n    Sonification.Valid a \u2227 Sonification.Valid b \u2227 b.hi < a.lo",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "Classical.choice",
      "propext",
      "Quot.sound"
    ],
    "declaration": "Sonification.exclusive",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "\u2200 (a b : Sonification.Interval),\n  Sonification.Valid a \u2192\n    Sonification.Valid b \u2192\n      \u00ac(a.hi < b.lo \u2227 b.hi < a.lo) \u2227\n        \u00ac(a.hi < b.lo \u2227 a.lo \u2264 b.hi \u2227 b.lo \u2264 a.hi) \u2227 \u00ac(b.hi < a.lo \u2227 a.lo \u2264 b.hi \u2227 b.lo \u2264 a.hi)",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext",
      "Quot.sound",
      "Classical.choice"
    ],
    "declaration": "Sonification.overlap_iff",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "\u2200 (a b : Sonification.Interval),\n  Sonification.classify a b = some Sonification.Relation.overlap \u2194\n    Sonification.Valid a \u2227 Sonification.Valid b \u2227 a.lo \u2264 b.hi \u2227 b.lo \u2264 a.hi",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext"
    ],
    "declaration": "Sonification.Ordered.order_reflecting_map",
    "kind": "theorem",
    "origin": "Sonification.OrderedIntervals",
    "type": "\u2200 {\u03b1 \u03b2 : Type} (o : Sonification.Ordered.OrderSpec \u03b1) (p : Sonification.Ordered.OrderSpec \u03b2) (f : \u03b1 \u2192 \u03b2),\n  (\u2200 (x y : \u03b1), p.lt (f x) (f y) \u2194 o.lt x y) \u2192\n    \u2200 (a b : Sonification.Ordered.Interval \u03b1),\n      Sonification.Ordered.classify p (Sonification.Ordered.map f a) (Sonification.Ordered.map f b) =\n        Sonification.Ordered.classify o a b",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext",
      "Quot.sound"
    ],
    "declaration": "Sonification.positive_scale",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "\u2200 (k : Int) (a b : Sonification.Interval),\n  0 < k \u2192 Sonification.classify (Sonification.scale k a) (Sonification.scale k b) = Sonification.classify a b",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext",
      "Quot.sound"
    ],
    "declaration": "Sonification.box_valid",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "\u2200 (center error : Int), 0 \u2264 error \u2192 Sonification.Valid (Sonification.box center error)",
    "unsafe_definition": false
  },
  {
    "axioms": [],
    "declaration": "Sonification.Ordered.separation_exclusive",
    "kind": "theorem",
    "origin": "Sonification.OrderedIntervals",
    "type": "\u2200 {\u03b1 : Type} (o : Sonification.Ordered.OrderSpec \u03b1) (a b : Sonification.Ordered.Interval \u03b1),\n  Sonification.Ordered.Valid o a \u2192 Sonification.Ordered.Valid o b \u2192 \u00ac(o.lt a.hi b.lo \u2227 o.lt b.hi a.lo)",
    "unsafe_definition": false
  },
  {
    "axioms": [],
    "declaration": "Sonification.Ordered.asymmetric",
    "kind": "theorem",
    "origin": "Sonification.OrderedIntervals",
    "type": "\u2200 {\u03b1 : Type} (o : Sonification.Ordered.OrderSpec \u03b1) {x y : \u03b1}, o.lt x y \u2192 \u00aco.lt y x",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext",
      "Quot.sound"
    ],
    "declaration": "Sonification.scale_lt_iff",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "\u2200 (k x y : Int), 0 < k \u2192 (k * x < k * y \u2194 x < y)",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext"
    ],
    "declaration": "Sonification.Ordered.classify_overlap_iff",
    "kind": "theorem",
    "origin": "Sonification.OrderedIntervals",
    "type": "\u2200 {\u03b1 : Type} (o : Sonification.Ordered.OrderSpec \u03b1) (a b : Sonification.Ordered.Interval \u03b1),\n  Sonification.Ordered.classify o a b = some Sonification.Ordered.Relation.overlap \u2194\n    Sonification.Ordered.Valid o a \u2227 Sonification.Ordered.Valid o b \u2227 \u00aco.lt a.hi b.lo \u2227 \u00aco.lt b.hi a.lo",
    "unsafe_definition": false
  },
  {
    "axioms": [],
    "declaration": "Sonification.inhabited_branches",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "Sonification.classify { lo := 0, hi := 1 } { lo := 2, hi := 3 } = some Sonification.Relation.below \u2227\n  Sonification.classify { lo := 2, hi := 3 } { lo := 0, hi := 1 } = some Sonification.Relation.above \u2227\n    Sonification.classify { lo := 0, hi := 1 } { lo := 1, hi := 2 } = some Sonification.Relation.overlap \u2227\n      Sonification.classify { lo := 1, hi := 0 } { lo := 0, hi := 0 } = none",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext",
      "Quot.sound",
      "Classical.choice"
    ],
    "declaration": "Sonification.touching",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "\u2200 (a b : Sonification.Interval),\n  Sonification.Valid a \u2192\n    Sonification.Valid b \u2192 a.hi = b.lo \u2192 Sonification.classify a b = some Sonification.Relation.overlap",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext",
      "Quot.sound",
      "Classical.choice"
    ],
    "declaration": "Sonification.below_iff",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "\u2200 (a b : Sonification.Interval),\n  Sonification.classify a b = some Sonification.Relation.below \u2194\n    Sonification.Valid a \u2227 Sonification.Valid b \u2227 a.hi < b.lo",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext"
    ],
    "declaration": "Sonification.Ordered.exhaustive",
    "kind": "theorem",
    "origin": "Sonification.OrderedIntervals",
    "type": "\u2200 {\u03b1 : Type} (o : Sonification.Ordered.OrderSpec \u03b1) (a b : Sonification.Ordered.Interval \u03b1),\n  Sonification.Ordered.Valid o a \u2192\n    Sonification.Ordered.Valid o b \u2192\n      Sonification.Ordered.classify o a b = some Sonification.Ordered.Relation.below \u2228\n        Sonification.Ordered.classify o a b = some Sonification.Ordered.Relation.above \u2228\n          Sonification.Ordered.classify o a b = some Sonification.Ordered.Relation.overlap",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext",
      "Quot.sound"
    ],
    "declaration": "Sonification.exhaustive",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "\u2200 (a b : Sonification.Interval),\n  Sonification.Valid a \u2192\n    Sonification.Valid b \u2192\n      Sonification.classify a b = some Sonification.Relation.below \u2228\n        Sonification.classify a b = some Sonification.Relation.above \u2228\n          Sonification.classify a b = some Sonification.Relation.overlap",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext"
    ],
    "declaration": "Sonification.invalid_iff",
    "kind": "theorem",
    "origin": "Sonification.Intervals",
    "type": "\u2200 (a b : Sonification.Interval), Sonification.classify a b = none \u2194 \u00acSonification.Valid a \u2228 \u00acSonification.Valid b",
    "unsafe_definition": false
  },
  {
    "axioms": [
      "propext"
    ],
    "declaration": "Sonification.Ordered.classify_below_iff",
    "kind": "theorem",
    "origin": "Sonification.OrderedIntervals",
    "type": "\u2200 {\u03b1 : Type} (o : Sonification.Ordered.OrderSpec \u03b1) (a b : Sonification.Ordered.Interval \u03b1),\n  Sonification.Ordered.classify o a b = some Sonification.Ordered.Relation.below \u2194\n    Sonification.Ordered.Valid o a \u2227 Sonification.Ordered.Valid o b \u2227 o.lt a.hi b.lo",
    "unsafe_definition": false
  }
]
